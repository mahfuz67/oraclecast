# ===========================================================================
# OracleCast — environment configuration
# Copy to `.env` and fill in. Anything left blank keeps the agent in DRY_RUN.
# ===========================================================================

# ---- Mode ----------------------------------------------------------------
# "1" = simulate everything (no chain writes, no real payments). Safe default.
# "0" = LIVE: registers on-chain, pays Ace via x402, settles escrow on mainnet.
DRY_RUN=1

# ---- Solana / Synapse RPC ------------------------------------------------
# Synapse RPC mainnet endpoint with your api_key (free tier:
# https://synapse.oobeprotocol.ai). Used as the Solana RPC for ALL chain ops.
SYNAPSE_RPC_URL=https://us-1-mainnet.oobeprotocol.ai/rpc?api_key=YOUR_KEY
# Optional public fallback if SYNAPSE_RPC_URL is unset.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Wallet (the agent's keypair) ----------------------------------------
# Provide ONE of these:
#   WALLET_PATH        path to a Solana CLI keypair json ([12,34,...])
#   WALLET_SECRET_KEY  base58 secret key OR json array of bytes
WALLET_PATH=./wallet.json
# WALLET_SECRET_KEY=

# ---- Ace Data Cloud ------------------------------------------------------
# Account: https://platform.acedata.cloud (sign up w/ Google/GitHub -> free credits)
ACE_BASE_URL=https://api.acedata.cloud
# Optional Bearer token (fallback when NOT paying via x402).
ACE_API_TOKEN=
# x402 settlement network for Ace payments.
ACE_PAYMENT_NETWORK=solana

# ---- SAP / Synapse Sentinel ----------------------------------------------
# Sentinel agent (Category 1 requires consuming it at least once).
SENTINEL_AGENT=Ccr2yK3hLALU4p8oNRqrh4dGuvPJTth5KCLMio8cE1ph

# ---- OOBE Protocol SDK (reasoning core) ----------------------------------
# Powers the agent's market "stance": personality-driven LLM reasoning +
# Merkle-proofed memory of prior briefings. Without an API key (or in DRY_RUN)
# a deterministic local stance is used, but the Merkle proof is always real.
OPENAI_API_KEY=
OOBE_KEY=
# LLM provider/model for the OOBE LLMFactory: openai|groq|mistral|ollama|together|xai|fireworks
OOBE_LLM_PROVIDER=openai
OOBE_LLM_MODEL=gpt-4o-mini

# ---- Agent identity (for SAP registration) -------------------------------
AGENT_NAME=OracleCast
AGENT_DESCRIPTION=Autonomous on-chain multimedia market-briefing agent.
# Public URI / x402 endpoint where this agent serves briefings (optional).
AGENT_URI=
AGENT_X402_ENDPOINT=

# ---- Sell side (Category 1 escrow volume) --------------------------------
# A REAL counterparty wallet that subscribes to OracleCast briefings.
# Leave blank to skip the sell-side settle step (avoids self-dealing).
SUBSCRIBER_PUBKEY=
# Price charged per delivered briefing, in lamports (or USDC base units).
PRICE_PER_CALL=1000000

# ---- Agentic loop guardrails ---------------------------------------------
# Max reasoning/action steps per run before the loop stops.
AGENT_MAX_STEPS=12
# Hard per-run spend caps (base units). lamports = SOL escrow; usdc = Ace x402.
RUN_BUDGET_LAMPORTS=5000000
RUN_BUDGET_USDC=500000
# Optional CSV of tool names the agent may call (empty = all). Tools:
# sense_market, web_search, risk_check_sentinel, decide_stance, write_analysis,
# make_infographic, make_audio, settle_payment
AGENT_TOOL_ALLOWLIST=

# ---- Scheduling / serving ------------------------------------------------
# Cron expression for autonomous briefing cadence (default: every 30 min).
BRIEFING_CRON=*/30 * * * *
PORT=8787
